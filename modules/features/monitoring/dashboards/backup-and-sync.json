{
  "annotations": {"list": []},
  "description": "Restic offsite backup, staged source, GitHub mirror, and Syncthing health.",
  "editable": false,
  "links": [{"title": "Fleet overview", "type": "dashboards", "dashboardUID": "henhal-fleet-overview", "targetBlank": false}, {"title": "Backup documentation", "type": "link", "url": "https://github.com/henhalvor/dotfiles/blob/main/docs/BACKUP.md", "targetBlank": true}],
  "panels": [
    {"type": "text", "title": "Purpose", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# Backup and synchronization\nThe encrypted Restic repository is in Cloudflare R2. Staged sources are local inputs and must be healthy before the nightly backup. Hermes is expected to show degraded until a native export is configured."}, "transparent": true},
    {"type": "stat", "title": "Latest snapshot age", "description": "Age of the latest successful HP offsite snapshot.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_snapshot_age_seconds{repository=\"hp-offsite\"}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 129600}, {"color": "red", "value": 259200}]}}, "overrides": []}},
    {"type": "stat", "title": "Repository check age", "description": "Age since the last successful sampled Restic integrity check.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "time() - henhal_backup_repository_check_last_success_timestamp_seconds", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 3024000}, {"color": "red", "value": 3888000}]}}, "overrides": []}},
    {"type": "stat", "title": "Required sources", "description": "Healthy required sources. Hermes is optional until its native export is implemented; expected value is five.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(henhal_backup_source_healthy{source!=\"hermes\"})", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"min": 0, "max": 5, "noValue": "Unknown", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 4}, {"color": "green", "value": 5}]}}, "overrides": []}},
    {"type": "stat", "title": "Backup heartbeat", "description": "Result of the latest external backup-success heartbeat delivery.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_heartbeat_delivery_healthy{repository=\"hp-offsite\"}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}, "fieldConfig": {"defaults": {"noValue": "Never sent", "mappings": [{"type": "value", "options": {"0": {"text": "Failed", "color": "red"}, "1": {"text": "Delivered", "color": "green"}}}]}, "overrides": []}},
    {"type": "stat", "title": "Staged source status", "description": "Named source states instead of raw metric labels. Hermes remains visible as Deferred until its exporter exists.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_source_healthy", "legendFormat": "{{source}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"noValue": "Unknown", "mappings": [{"type": "value", "options": {"0": {"text": "Degraded", "color": "orange"}, "1": {"text": "Healthy", "color": "green"}}}]}, "overrides": [{"matcher": {"id": "byName", "options": "hermes"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "Deferred", "color": "blue"}, "1": {"text": "Healthy", "color": "green"}}}]}]}]}},
    {"type": "timeseries", "title": "Syncthing pending items", "description": "Pending items for Vault and Shared; zero is fully synchronized.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_syncthing_pending_items", "legendFormat": "{{host}} · {{folder}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Restic snapshot age history", "description": "Expected saw-tooth pattern from the nightly backup; rising values indicate missed runs.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_snapshot_age_seconds{repository=\"hp-offsite\"}", "legendFormat": "hp-offsite", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}},
    {"type": "timeseries", "title": "GitHub mirror and source freshness", "description": "Age of each staged-source status. GitHub mirror status is one of these sources.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "time() - henhal_backup_source_status_timestamp_seconds", "legendFormat": "{{source}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["henhal", "backup", "syncthing"],
  "templating": {"list": [{"name": "host", "label": "Backup host", "type": "constant", "query": "hp-server", "hide": 2, "current": {"text": "hp-server", "value": "hp-server"}}]},
  "time": {"from": "now-7d", "to": "now"},
  "timezone": "browser",
  "title": "Backup and synchronization",
  "uid": "henhal-backup-sync",
  "version": 1
}
