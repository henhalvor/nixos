{
  "annotations": {"list": []},
  "description": "At-a-glance availability, capacity, public endpoint, backup, and synchronization health for the home fleet.",
  "editable": false,
  "links": [{"title": "Backup documentation", "type": "link", "url": "https://github.com/henhalvor/dotfiles/blob/main/docs/BACKUP.md", "targetBlank": true}],
  "panels": [
    {"type": "text", "title": "Purpose", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# Fleet overview\nGreen means a recent successful metric, not merely an absent error. Select a host below; use **Logs** to investigate alerts."}, "transparent": true},
    {"type": "stat", "title": "Node exporter availability", "description": "Number of currently reachable node exporters; expected value is 3 when every machine is online.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(up{job=\"node\"})", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 1}, {"color": "green", "value": 3}]}}, "overrides": []}},
    {"type": "stat", "title": "Firing alerts", "description": "Current alerts by severity. Open Alertmanager or the Logs dashboard for detail.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\"})", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}}, "overrides": []}},
    {"type": "stat", "title": "Latest Restic snapshot age", "description": "Age of the latest successful encrypted offsite snapshot. It runs nightly at 03:00.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_snapshot_age_seconds{repository=\"hp-offsite\"}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 129600}, {"color": "red", "value": 259200}]}}, "overrides": []}},
    {"type": "stat", "title": "HP uptime", "description": "Time since hp-server last booted.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "time() - node_boot_time_seconds{host=\"hp-server\"}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"type": "timeseries", "title": "CPU usage by host", "description": "Non-idle CPU utilization. Offline machines are shown as gaps rather than healthy values.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"}[5m])))", "legendFormat": "{{host}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Root filesystem use", "description": "Percentage use on each selected host's root filesystem.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "table", "title": "Public HTTPS probes", "description": "External-looking HTTP/TLS probes from HP for Cloud, Auth, and Monitor.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "probe_success{job=\"blackbox-http\"}", "format": "table", "instant": true, "refId": "A"}, {"expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400", "format": "table", "instant": true, "refId": "B"}], "transformations": [{"id": "merge", "options": {}}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"showHeader": true}},
    {"type": "table", "title": "Backup source health", "description": "Staged source health. Hermes may be degraded until it has a reviewed native export path.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_source_healthy", "format": "table", "instant": true, "refId": "A"}, {"expr": "time() - henhal_backup_source_status_timestamp_seconds", "format": "table", "instant": true, "refId": "B"}], "transformations": [{"id": "merge", "options": {}}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"showHeader": true}},
    {"type": "timeseries", "title": "Syncthing pending items", "description": "Pending synchronized items in the Vault and Shared folders. Persistent nonzero values need attention.", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_syncthing_pending_items", "legendFormat": "{{folder}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["henhal", "overview"],
  "templating": {"list": [{"name": "host", "label": "Host", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(up{job=\"node\"}, host)", "query": {"query": "label_values(up{job=\"node\"}, host)", "refId": "StandardVariableQuery"}, "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": ["$__all"]}}]},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Fleet overview",
  "uid": "henhal-fleet-overview",
  "version": 1
}
