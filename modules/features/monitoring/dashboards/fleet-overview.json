{
  "annotations": {"list": []},
  "description": "At-a-glance availability, capacity, public endpoint, backup, and synchronization health for the home fleet.",
  "editable": false,
  "links": [
    {"title": "Logs", "type": "dashboards", "dashboardUID": "henhal-logs", "targetBlank": false},
    {"title": "HP services", "type": "dashboards", "dashboardUID": "henhal-hp-services", "targetBlank": false},
    {"title": "Backup documentation", "type": "link", "url": "https://github.com/henhalvor/dotfiles/blob/main/docs/BACKUP.md", "targetBlank": true}
  ],
  "panels": [
    {"type": "text", "title": "Purpose", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# Fleet overview\nA quiet operational pulse for the whole fleet. **Green means measured healthy**; missing hosts stay unknown. Current resource cards are phone-friendly, while timelines preserve desktop context."}, "transparent": true},
    {"type": "stat", "title": "Fleet connectivity", "description": "Current exporter state by host. Lenovo may be offline by design; missing data remains unknown.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up{job=\"node\"}", "legendFormat": "{{host}}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"noValue": "Unknown", "mappings": [{"type": "value", "options": {"0": {"text": "Offline", "color": "orange"}, "1": {"text": "Up", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}},
    {"type": "stat", "title": "Actionable alerts", "description": "Firing alerts eligible for notification. Only the deferred Hermes source and Nix-store capacity conditions are excluded.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "(sum(ALERTS{alertstate=\"firing\",alertname!=\"NixStoreLarge\",alertname!~\"BackupSourceDegraded|BackupSourceStillDegraded\"}) or vector(0)) + (sum(ALERTS{alertstate=\"firing\",alertname=~\"BackupSourceDegraded|BackupSourceStillDegraded\",source!=\"hermes\"}) or vector(0))", "refId": "A", "instant": true}], "links": [{"title": "Open HP services", "url": "/d/henhal-hp-services/hp-services", "targetBlank": false}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}}, "overrides": []}},
    {"type": "stat", "title": "Latest Restic snapshot age", "description": "Age of the latest successful encrypted offsite snapshot. It runs nightly at 03:00.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_snapshot_age_seconds{repository=\"hp-offsite\"}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 129600}, {"color": "red", "value": 259200}]}}, "overrides": []}},
    {"type": "stat", "title": "HP log errors · 1h", "description": "Error, fatal, or failed journal messages observed on hp-server in the last hour. Open Logs to investigate; warnings are intentionally excluded.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 3}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "sum(count_over_time({host=\"hp-server\"} |~ \"(?i)(error|fatal|failed)\" [1h])) or vector(0)", "refId": "A", "queryType": "instant"}], "links": [{"title": "Investigate in Logs", "url": "/d/henhal-logs/logs?var-host=hp-server&from=now-1h&to=now", "targetBlank": false}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"noValue": "Unknown", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []}},
    {"type": "stat", "title": "CPU now", "description": "Current five-minute CPU utilization by selected host. Cards stack vertically on narrow screens.", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"}[5m])))", "legendFormat": "{{host}}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "noValue": "Offline", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "stat", "title": "Memory now", "description": "Current used memory by selected host, based on MemAvailable rather than cache-inclusive free memory.", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"})", "legendFormat": "{{host}}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "noValue": "Offline", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "stat", "title": "Root disk now", "description": "Current root-filesystem capacity used by selected host.", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}}", "refId": "A", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "noValue": "Offline", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "timeseries", "title": "CPU usage by host", "description": "Non-idle CPU utilization. Offline machines are shown as gaps rather than healthy values.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"}[5m])))", "legendFormat": "{{host}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Memory usage by host", "description": "Used memory derived from MemAvailable. Offline machines remain gaps, never false healthy values.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"})", "legendFormat": "{{host}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Root filesystem use", "description": "Percentage use on each selected host's root filesystem.", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 22}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "stat", "title": "Public endpoints", "description": "Current reachability of Cloud, Auth, and Monitor through their public HTTPS routes.", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 30}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "probe_success{job=\"blackbox-http\"}", "legendFormat": "{{instance}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"noValue": "Unknown", "mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}]}, "overrides": []}},
    {"type": "stat", "title": "TLS certificate life", "description": "Days remaining before each public certificate expires.", "gridPos": {"h": 8, "w": 6, "x": 6, "y": 30}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400", "legendFormat": "{{instance}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "d", "decimals": 0, "noValue": "Unknown", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 7}, {"color": "green", "value": 21}]}}, "overrides": []}},
    {"type": "stat", "title": "Backup sources", "description": "Current staged-source state. Hermes is intentionally deferred until a native export exists.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_backup_source_healthy", "legendFormat": "{{source}}", "instant": true, "refId": "A"}], "links": [{"title": "Open Backup dashboard", "url": "/d/henhal-backup-sync/backup-and-synchronization", "targetBlank": false}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"noValue": "Unknown", "mappings": [{"type": "value", "options": {"0": {"text": "Degraded", "color": "orange"}, "1": {"text": "Healthy", "color": "green"}}}]}, "overrides": [{"matcher": {"id": "byName", "options": "hermes"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "Deferred", "color": "blue"}, "1": {"text": "Healthy", "color": "green"}}}]}]}]}},
    {"type": "timeseries", "title": "Syncthing pending items", "description": "Pending synchronized items in the Vault and Shared folders. Persistent nonzero values need attention.", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 38}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_syncthing_pending_items", "legendFormat": "{{host}} · {{folder}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["henhal", "overview"],
  "templating": {"list": [{"name": "host", "label": "Host", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(up{job=\"node\"}, host)", "query": {"query": "label_values(up{job=\"node\"}, host)", "refId": "StandardVariableQuery"}, "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": ["$__all"]}}]},
  "time": {"from": "now-24h", "to": "now"},
