{
  "annotations": {"list": []},
  "description": "Filesystem, disk I/O, SMART/NVMe, temperature, battery, and bounded per-executable resource usage for all hosts.",
  "editable": false,
  "links": [{"title": "Fleet overview", "type": "dashboards", "dashboardUID": "henhal-fleet-overview", "targetBlank": false}],
  "panels": [
    {"type": "text", "title": "Purpose", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# Storage and hardware\nThis dashboard is observational. Disk health warnings should trigger a backup review and SMART inspection, not automatic repair or long-running disk tests."}, "transparent": true},
    {"type": "stat", "title": "Root capacity now", "description": "Current root-filesystem usage by selected host.", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "noValue": "Offline", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "stat", "title": "OpenCloud T7", "description": "Used capacity and remaining space on the HP OpenCloud filesystem.", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{host=\"hp-server\",mountpoint=\"/srv/opencloud\"} / node_filesystem_size_bytes{host=\"hp-server\",mountpoint=\"/srv/opencloud\"})", "legendFormat": "Used", "instant": true, "refId": "A"}, {"expr": "node_filesystem_avail_bytes{host=\"hp-server\",mountpoint=\"/srv/opencloud\"}", "legendFormat": "Free", "instant": true, "refId": "B"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"noValue": "Not mounted"}, "overrides": [{"matcher": {"id": "byName", "options": "Used"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "decimals", "value": 1}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}]}, {"matcher": {"id": "byName", "options": "Free"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}]}},
    {"type": "stat", "title": "Hottest sensor now", "description": "Maximum reported hardware temperature per selected host.", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "max by (host) (node_hwmon_temp_celsius{host=~\"$host\"})", "legendFormat": "{{host}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1, "noValue": "Not reported", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 75}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Filesystem usage", "description": "Used capacity for persistent filesystems. The T7 OpenCloud filesystem is mounted at /srv/opencloud on HP.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}} {{mountpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Filesystem inode usage", "description": "Used inode percentage for persistent filesystems.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_files_free{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_files{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}} {{mountpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "stat", "title": "SMART health", "description": "Normalized health by physical drive. A failed value requires manual SMART inspection, not automatic repair.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_storage_smart_healthy{host=~\"$host\"}", "legendFormat": "{{host}} · {{device}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"noValue": "Not reported", "mappings": [{"type": "value", "options": {"0": {"text": "Failed", "color": "red"}, "1": {"text": "Healthy", "color": "green"}}}]}, "overrides": []}},
    {"type": "timeseries", "title": "Disk I/O throughput", "description": "Read and write rate per physical disk. Loop, RAM, and device-mapper duplicates are excluded.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "rate(node_disk_read_bytes_total{host=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m])", "legendFormat": "read {{host}} {{device}}", "refId": "A"}, {"expr": "rate(node_disk_written_bytes_total{host=~\"$host\",device!~\"loop.*|ram.*|dm-.*\"}[5m])", "legendFormat": "write {{host}} {{device}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Host temperature", "description": "All hardware-monitor sensors where exposed by node_exporter.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_hwmon_temp_celsius{host=~\"$host\"}", "legendFormat": "{{host}} {{chip}} {{sensor}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "celsius", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 75}]}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Battery telemetry", "description": "Charge and capacity-health metrics for selected hosts when a battery is reported. Missing data means offline or not reported.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_power_supply_capacity{host=~\"$host\"}", "legendFormat": "charge {{host}} {{power_supply}}", "refId": "A"}, {"expr": "100 * henhal_battery_capacity_ratio{host=~\"$host\"}", "legendFormat": "health {{host}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "noValue": "Not reported"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "text", "title": "Process drill-down", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 33}, "options": {"mode": "markdown", "content": "## Process drill-down\nUse this section after a Fleet overview spike. Processes are safely grouped by executable name: no command lines, arguments, or per-PID labels are collected. CPU is shown as percent of one CPU core, so a multi-threaded process can exceed 100%."}, "transparent": true},
    {"type": "bargauge", "title": "Top CPU process groups now", "description": "The ten busiest executable groups across the selected hosts over the last five minutes. 100% equals one fully occupied CPU core.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(10, 100 * sum by (host, groupname) (rate(namedprocess_namegroup_cpu_seconds_total{host=~\"$host\"}[5m])))", "legendFormat": "{{host}} · {{groupname}}", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "noValue": "No process data", "color": {"mode": "continuous-GrYlRd"}}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 16, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "valueMode": "color"}},
    {"type": "bargauge", "title": "Top memory process groups now", "description": "The ten executable groups using the most resident memory across the selected hosts.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(10, sum by (host, groupname) (namedprocess_namegroup_memory_bytes{host=~\"$host\",memtype=\"resident\"}))", "legendFormat": "{{host}} · {{groupname}}", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1, "min": 0, "noValue": "No process data", "color": {"mode": "continuous-BlYlRd"}}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 16, "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "valueMode": "color"}},
    {"type": "timeseries", "title": "CPU by process group", "description": "Historical CPU use for the busiest executable groups. 100% equals one CPU core.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 44}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(10, 100 * sum by (host, groupname) (rate(namedprocess_namegroup_cpu_seconds_total{host=~\"$host\"}[5m])))", "legendFormat": "{{host}} · {{groupname}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Resident memory by process group", "description": "Historical resident memory for the largest executable groups.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 44}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(10, sum by (host, groupname) (namedprocess_namegroup_memory_bytes{host=~\"$host\",memtype=\"resident\"}))", "legendFormat": "{{host}} · {{groupname}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}}
  ],
