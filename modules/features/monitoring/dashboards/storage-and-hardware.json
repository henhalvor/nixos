{
  "annotations": {"list": []},
  "description": "Filesystem, disk I/O, SMART/NVMe, temperature, and battery health for all hosts.",
  "editable": false,
  "panels": [
    {"type": "text", "title": "Purpose", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# Storage and hardware\nThis dashboard is observational. Disk health warnings should trigger a backup review and SMART inspection, not automatic repair or long-running disk tests."}, "transparent": true},
    {"type": "timeseries", "title": "Filesystem usage", "description": "Used capacity for persistent filesystems. The T7 OpenCloud filesystem is mounted at /srv/opencloud on HP.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}} {{mountpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Filesystem inode usage", "description": "Used inode percentage for persistent filesystems.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_files_free{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"} / node_filesystem_files{fstype!~\"tmpfs|overlay|squashfs\",host=~\"$host\"})", "legendFormat": "{{host}} {{mountpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "table", "title": "SMART and drive health", "description": "Normalized drive health from the local smartctl collector. A zero health result requires manual SMART inspection.", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 11}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_storage_smart_healthy", "format": "table", "instant": true, "refId": "A"}, {"expr": "henhal_storage_temperature_celsius", "format": "table", "instant": true, "refId": "B"}], "transformations": [{"id": "merge", "options": {}}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"showHeader": true}},
    {"type": "timeseries", "title": "Disk I/O throughput", "description": "Combined read and write rate per disk device. Excludes loop and RAM devices.", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 11}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "rate(node_disk_read_bytes_total{host=~\"$host\",device!~\"loop.*|ram.*\"}[5m])", "legendFormat": "read {{host}} {{device}}", "refId": "A"}, {"expr": "rate(node_disk_written_bytes_total{host=~\"$host\",device!~\"loop.*|ram.*\"}[5m])", "legendFormat": "write {{host}} {{device}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Host temperature", "description": "Hardware-monitor temperatures where exposed by node_exporter.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_hwmon_temp_celsius{host=~\"$host\"}", "legendFormat": "{{host}} {{chip}} {{sensor}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Lenovo battery", "description": "Battery charge percentage and designed-versus-current full capacity ratio, when the laptop is online.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_power_supply_capacity{host=\"lenovo-yoga-pro-7\"}", "legendFormat": "Charge", "refId": "A"}, {"expr": "100 * henhal_battery_capacity_ratio{host=\"lenovo-yoga-pro-7\"}", "legendFormat": "Full/design capacity", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
