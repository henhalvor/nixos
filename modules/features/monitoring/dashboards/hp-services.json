{
  "annotations": {"list": []},
  "description": "Health and resource use for HP-hosted applications and the monitoring stack.",
  "editable": false,
  "links": [{"title": "Fleet overview", "type": "dashboards", "dashboardUID": "henhal-fleet-overview", "targetBlank": false}, {"title": "Logs", "type": "dashboards", "dashboardUID": "henhal-logs", "targetBlank": false}],
  "panels": [
    {"type": "text", "title": "Purpose", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# HP services\nUse this page to correlate a failed unit, restarts, local probes, and relevant journal errors. A failed metric is not automatically a reason to restart a service."}, "transparent": true},
    {"type": "stat", "title": "Failed units", "description": "Explicit zero-state for failed HP systemd units.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(node_systemd_unit_state{host=\"hp-server\",state=\"failed\"} == 1) or vector(0)", "instant": true, "refId": "A"}], "links": [{"title": "Investigate in Logs", "url": "/d/henhal-logs/logs?var-host=hp-server", "targetBlank": false}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}},
    {"type": "stat", "title": "CPU now", "description": "Current five-minute HP CPU utilization.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{host=\"hp-server\",mode=\"idle\"}[5m])))", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "stat", "title": "Memory now", "description": "Current HP memory use based on MemAvailable.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{host=\"hp-server\"} / node_memory_MemTotal_bytes{host=\"hp-server\"})", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "stat", "title": "Root disk now", "description": "Current HP root-filesystem use.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 3}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{host=\"hp-server\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{host=\"hp-server\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"})", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}},
    {"type": "stat", "title": "Local service probes", "description": "Named application health checks on HP. Every value should read Up.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "henhal_service_probe_success{host=\"hp-server\"}", "legendFormat": "{{service}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"noValue": "Unknown", "mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}]}, "overrides": []}},
    {"type": "stat", "title": "Service restarts · 24h", "description": "Changes in systemd restart counters during the last day; zero is expected.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (service) (changes(henhal_service_restart_count{host=\"hp-server\"}[24h]))", "legendFormat": "{{service}}", "instant": true, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "vertical", "textMode": "value_and_name", "wideLayout": false, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}}, "overrides": []}},
    {"type": "timeseries", "title": "HP CPU and memory", "description": "Host-level pressure associated with service trouble.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{host=\"hp-server\",mode=\"idle\"}[5m])))", "legendFormat": "CPU", "refId": "A"}, {"expr": "100 * (1 - node_memory_MemAvailable_bytes{host=\"hp-server\"} / node_memory_MemTotal_bytes{host=\"hp-server\"})", "legendFormat": "Memory", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Public endpoint latency", "description": "HTTP probe latency for public Cloud, Auth, and Monitor URLs.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "probe_http_duration_seconds{job=\"blackbox-http\"}", "legendFormat": "{{instance}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "logs", "title": "Recent HP service warnings and errors", "description": "Journal entries from the HP service allowlist and warning/error messages.", "gridPos": {"h": 12, "w": 24, "x": 0, "y": 24}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{host=\"hp-server\"} |~ \"(?i)(error|warn|fatal|failed)\"", "refId": "A"}], "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyJSON": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}}
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["henhal", "hp-server", "services"],
  "templating": {"list": [{"name": "host", "label": "Host", "type": "constant", "query": "hp-server", "hide": 2, "current": {"text": "hp-server", "value": "hp-server"}}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "HP services",
  "uid": "henhal-hp-services",
  "version": 1
}
