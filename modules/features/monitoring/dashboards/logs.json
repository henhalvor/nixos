  "panels": [
    {"type": "text", "title": "Purpose", "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# Logs\nStart with warning/error messages, then select a service unit. Logs are retained for operational investigation, not as the canonical source of configuration or secrets."}, "transparent": true},
    {"type": "timeseries", "title": "Warning/error rate by host", "description": "Rate of journal messages containing common warning/error terms.", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 3}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "sum by (host) (rate({host=~\"$host\"} |~ \"(?i)(error|warn|fatal|failed)\" [$__rate_interval]))", "legendFormat": "{{host}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "timeseries", "title": "Warning/error rate by unit", "description": "Rate for the selected host and optional systemd unit.", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 3}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "sum by (unit) (rate({host=~\"$host\", unit=~\"$unit\"} |~ \"(?i)(error|warn|fatal|failed)\" [$__rate_interval]))", "legendFormat": "{{unit}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"type": "bargauge", "title": "Noisy units · 1h", "description": "Units producing the most error-like entries during the last hour. Use this as a triage lead, not a fault verdict.", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 3}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "topk(8, sum by (unit) (count_over_time({host=~\"$host\",unit=~\".+\"} |~ \"(?i)(error|fatal|failed)\" [1h])))", "legendFormat": "{{unit}}", "queryType": "instant", "refId": "A"}], "options": {"displayMode": "gradient", "minVizWidth": 8, "minVizHeight": 8, "orientation": "horizontal", "showUnfilled": true, "valueMode": "color"}, "fieldConfig": {"defaults": {"min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []}},
    {"type": "logs", "title": "Selected journal messages", "description": "Recent messages for the selected host and unit. Use the Filter selector for common investigations.", "gridPos": {"h": 16, "w": 24, "x": 0, "y": 11}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{host=~\"$host\", unit=~\"$unit\"} $filter", "refId": "A"}], "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyJSON": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}}
